# Optional platform-level AI provider API keys
# GROQ_API_KEY enables the shared default Groq fallback for users who have not configured their own key yet.
GROQ_API_KEY=gsk-your-groq-key
# Optional but recommended for cross-instance global rate limiting of the shared Groq fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Other provider keys are optional and mainly useful for local debugging or future platform-managed provider modes.
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
DEEPSEEK_API_KEY=sk-your-deepseek-key
GOOGLE_API_KEY=your-google-api-key

# AI provider OAuth client IDs (browser-based authorization, NOT account sign-in)
NEXT_PUBLIC_OPENAI_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# AI provider OAuth client secrets (server-side only, for token exchange)
OPENAI_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=

# Local-only providers; not suitable for Vercel production deployment.
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_API_KEY=
NEXT_PUBLIC_KOKORO_SERVER_URL=xxxx

ZAI_API_KEY=your-zai-api-key

# Supabase Auth
# Account sign-in uses phone + SMS OTP. The SMS provider is configured in the
# Supabase Dashboard (Authentication -> Providers -> Phone), so no app-side env
# var is needed. See docs/supabase-setup.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Development-only sign-in shortcut: a fixed phone plus a fixed SMS code, with no
# real SMS and no Supabase call. Set NEXT_PUBLIC_ENABLE_DEV_LOGIN=true in
# .env.development.local — NOT in .env.local, which production builds also load.
# Leave empty to disable.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=
